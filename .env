# Public build-time base URL used for absolute SEO / Open-Graph tags (index.html
# and src/Seo.jsx). Contains no secrets – safe to commit. Vite replaces
# %VITE_SITE_URL% at build time.
# Live domain since the move to Infomaniak/Ploi (2026-08-12): valanto.ch WITHOUT
# www is the primary host – www.valanto.ch 301-redirects to it, and subpages
# are served with a trailing slash (/kontakt → /kontakt/). Canonicals, sitemap
# and internal links follow that form so nothing goes through a redirect.
VITE_SITE_URL=https://valanto.ch

# GA4 measurement ID. Placeholder until the real ID is available from the
# Google Analytics account — loadAnalytics() (src/analytics.js) treats
# "G-XXXXXXXXXX" as "not configured" and stays a no-op, even after consent.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
